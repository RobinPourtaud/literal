{
  "nodeModulesDir": "auto",
  "imports": {
    "@literal/core": "./packages/core/src/index.ts",
    "vite": "npm:vite@7.3.7",
    "lucide": "npm:lucide@0.468.0"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "types": [
      "./apps/web/src/assets.d.ts"
    ]
  },
  "tasks": {
    "dev": "deno run -A npm:vite@7.3.7 --config apps/web/vite.config.ts",
    "check": "deno check apps/web/src/main.ts packages/core/src/index.ts",
    "test": "deno test tests/",
    "build": "deno task check && deno run -A npm:vite@7.3.7 build --config apps/web/vite.config.ts",
    "preview": "deno run -A npm:vite@7.3.7 preview --config apps/web/vite.config.ts",
    "fmt": "deno fmt",
    "browser-check": "deno run --allow-run=orca --allow-write=docs scripts/browser_check.ts",
    "fmt-check": "deno fmt --check",
    "features-check": "deno run --allow-run=orca --allow-write=docs scripts/features_check.ts",
    "computer-check": "deno run --allow-run=orca --allow-write=docs scripts/computer_check.ts",
    "inside-check": "deno run --allow-run=orca --allow-write=/tmp scripts/inside_check.ts",
    "clock-check": "deno run --allow-run=orca scripts/clock_check.ts",
    "curriculum-check": "deno run --allow-run=orca --allow-write=docs scripts/curriculum_check.ts",
    "discover-check": "deno run --allow-run=orca --allow-write=docs scripts/discover_check.ts",
    "api-check": "deno run --allow-run=orca scripts/api_check.ts",
    "deploy": "deno task build && deno run -A npm:wrangler@4.149.0 deploy",
    "deploy-check": "deno task build && deno run -A npm:wrangler@4.149.0 deploy --dry-run"
  },
  "fmt": {
    "exclude": [
      "deno.lock",
      "dist",
      "node_modules",
      "apps/web/.vite"
    ]
  }
}
